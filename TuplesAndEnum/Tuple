//Using Tuple destructuring
let(name, price) = ("iphone", 900.0)
print(name)
print(price)
func calculateBill(
  price:Double,
  discountPercentage: Double) -> (original:Double, final:Double) {
  let finalPrice = price * (1 - discountPercentage / 100)
  return (original:price, final:finalPrice)
  }

let bill = calculateBill(price:1000, discountPercentage:10)
print(bill.original)
print(bill.final)